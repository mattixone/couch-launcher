<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Couch Launcher - a full-screen, D-pad-driven home screen for the Beelink,
    driven by the Retroid through the Pico like everything else.

    Built on the Mac (EnableWindowsTargeting) and published by release.sh.
    It only RUNS on Windows.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>CouchLauncher</AssemblyName>
    <RootNamespace>CouchLauncher</RootNamespace>
    <Version>0.0.1</Version>
    <!-- Set by release.sh to the GitHub repo the updates are published to. -->
    <UpdateRepo></UpdateRepo>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="UpdateRepo" Value="$(UpdateRepo)" />
    <!-- WPF drops System.IO from the implicit usings (its Path clashes with
         Shapes.Path). Nothing here uses Shapes by short name, so bring it back. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- The phone remote page, from github.com/mattixone/CouchControllerWeb.
         release.sh refreshes it before each build. -->
    <EmbeddedResource Include="web\index.html" LogicalName="CouchLauncher.web.index.html" />
    <!-- Live Surfer's script for streaming sites' pages (see LiveSurfer.cs). -->
    <EmbeddedResource Include="sites\*.js" LogicalName="CouchLauncher.sites.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Installer + self-updater. Keep in step with vpk in .config/dotnet-tools.json. -->
    <PackageReference Include="Velopack" Version="1.2.0" />
    <!-- WMI, to find browser windows the launcher opened before it last restarted. -->
    <PackageReference Include="System.Management" Version="10.0.12" />
    <!-- QR code for the phone remote, so guests can scan it off the TV. -->
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <!-- Only for Settings › DRM CHECK: can a browser built into the launcher play the streaming sites? -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

</Project>
